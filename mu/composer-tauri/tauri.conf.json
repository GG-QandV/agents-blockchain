{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Delta Composer",
  "version": "0.1.0",
  "identifier": "app.mu.composer",
  "build": { "frontendDist": "ui" },
  "app": {
    "windows": [{ "title": "Δ-Composer", "width": 760, "height": 640, "resizable": true }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"]
  }
}
